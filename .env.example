# Server-only upstream API base URL (never expose via VITE_* variables).
# Production requires HTTPS (e.g. an authorized HTTPS API gateway in front of the upstream cluster).
# Reference internal HTTP endpoint (for local/private tunnel testing only):
# http://ALB-Cluster-neo-api-1301981680.us-east-1.elb.amazonaws.com:8081/api
NEO_API_BASE_URL=

# Optional: set to "true" ONLY when running inside a private VPC/tunnel with an internal HTTP upstream.
# Leave unset or "false" in public production deployments to enforce TLS.
ALLOW_PRIVATE_HTTP_UPSTREAM=false

# Optional: path to persistent encrypted session file (e.g. /var/data/sessions.enc.json on Render Persistent Disk).
SESSION_STORE_PATH=

# Server port (Render automatically injects PORT; default 3000 locally)
PORT=3000
